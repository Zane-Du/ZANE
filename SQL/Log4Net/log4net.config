<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>

	<log4net debug="false">
		<!-- Colored Console Appender -->
		<appender name="ColoredConsoleAppender" type="log4net.Appender.ManagedColoredConsoleAppender">
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="{&quot;Date&quot;:&quot;%date{yyyy-MM-dd HH:mm:ss fffff}&quot;,&quot;level&quot;:&quot;%level&quot;,&quot;message&quot;:&quot;%message&quot;,&quot;file&quot;:&quot;%file&quot;,&quot;line&quot;:&quot;%line&quot;,&quot;exception&quot;:&quot;%exception&quot;}%newline" />
			</layout>
			<!-- Log Level Color Mappings -->
			<mapping>
				<level value="DEBUG" />
				<foreColor value="White" />
			</mapping>
			<mapping>
				<level value="INFO" />
				<foreColor value="Green" />
			</mapping>
			<mapping>
				<level value="WARN" />
				<foreColor value="Yellow" />
			</mapping>
			<mapping>
				<level value="ERROR" />
				<foreColor value="Red" />
			</mapping>
			<mapping>
				<level value="FATAL" />
				<foreColor value="Magenta" />
			</mapping>
		</appender>

		<!-- Rolling File Appender with JSON Layout and Size Limiting -->
		<appender name="RollingFileAppenderDebug" type="log4net.Appender.RollingFileAppender">
			<file value="logs/Debug/logfile.txt" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<!-- Roll by date -->
			<datePattern value="yyyyMMdd'.log'" />
			<!-- New log file each day with date in filename -->
			<maxSizeRollBackups value="5" />
			<!-- Keep 5 previous backups -->
			<maximumFileSize value="10MB" />
			<!-- Max file size before rolling over -->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="{&quot;Date&quot;:&quot;%date{yyyy-MM-dd HH:mm:ss fffff}&quot;,&quot;level&quot;:&quot;%level&quot;,&quot;message&quot;:&quot;%message&quot;,&quot;file&quot;:&quot;%file&quot;,&quot;line&quot;:&quot;%line&quot;,&quot;exception&quot;:&quot;%exception&quot;}%newline" />
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter">
				<levelMin value="Debug" />
				<levelMax value="Debug" />
			</filter>
		</appender>

		<!-- Rolling File Appender with JSON Layout and Size Limiting -->
		<appender name="RollingFileAppenderInfo" type="log4net.Appender.RollingFileAppender">
			<file value="logs/Info/logfile.txt" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<!-- Roll by date -->
			<datePattern value="yyyyMMdd'.log'" />
			<!-- New log file each day with date in filename -->
			<maxSizeRollBackups value="5" />
			<!-- Keep 5 previous backups -->
			<maximumFileSize value="10MB" />
			<!-- Max file size before rolling over -->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="{&quot;Date&quot;:&quot;%date{yyyy-MM-dd HH:mm:ss fffff}&quot;,&quot;level&quot;:&quot;%level&quot;,&quot;message&quot;:&quot;%message&quot;,&quot;file&quot;:&quot;%file&quot;,&quot;line&quot;:&quot;%line&quot;,&quot;exception&quot;:&quot;%exception&quot;}%newline" />
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter">
				<levelMin value="Info" />
				<levelMax value="Info" />
			</filter>
		</appender>

		<!-- Rolling File Appender with JSON Layout and Size Limiting -->
		<appender name="RollingFileAppenderWarn" type="log4net.Appender.RollingFileAppender">
			<file value="logs/Warn/logfile.txt" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<!-- Roll by date -->
			<datePattern value="yyyyMMdd'.log'" />
			<!-- New log file each day with date in filename -->
			<maxSizeRollBackups value="5" />
			<!-- Keep 5 previous backups -->
			<maximumFileSize value="10MB" />
			<!-- Max file size before rolling over -->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="{&quot;Date&quot;:&quot;%date{yyyy-MM-dd HH:mm:ss fffff}&quot;,&quot;level&quot;:&quot;%level&quot;,&quot;message&quot;:&quot;%message&quot;,&quot;file&quot;:&quot;%file&quot;,&quot;line&quot;:&quot;%line&quot;,&quot;exception&quot;:&quot;%exception&quot;}%newline" />
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter">
				<levelMin value="Warn" />
				<levelMax value="Warn" />
			</filter>
		</appender>

		<!-- Rolling File Appender with JSON Layout and Size Limiting -->
		<appender name="RollingFileAppenderError" type="log4net.Appender.RollingFileAppender">
			<file value="logs/Error/logfile.txt" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<!-- Roll by date -->
			<datePattern value="yyyyMMdd'.log'" />
			<!-- New log file each day with date in filename -->
			<maxSizeRollBackups value="5" />
			<!-- Keep 5 previous backups -->
			<maximumFileSize value="10MB" />
			<!-- Max file size before rolling over -->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="{&quot;Date&quot;:&quot;%date{yyyy-MM-dd HH:mm:ss fffff}&quot;,&quot;level&quot;:&quot;%level&quot;,&quot;message&quot;:&quot;%message&quot;,&quot;file&quot;:&quot;%file&quot;,&quot;line&quot;:&quot;%line&quot;,&quot;exception&quot;:&quot;%exception&quot;}%newline" />
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter">
				<levelMin value="ERROR" />
				<levelMax value="ERROR" />
			</filter>
		</appender>

		<!-- Rolling File Appender with JSON Layout and Size Limiting -->
		<appender name="RollingFileAppenderFatal" type="log4net.Appender.RollingFileAppender">
			<file value="logs/Fatal/logfile.txt" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<!-- Roll by date -->
			<datePattern value="yyyyMMdd'.log'" />
			<!-- New log file each day with date in filename -->
			<maxSizeRollBackups value="5" />
			<!-- Keep 5 previous backups -->
			<maximumFileSize value="10MB" />
			<!-- Max file size before rolling over -->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="{&quot;Date&quot;:&quot;%date{yyyy-MM-dd HH:mm:ss fffff}&quot;,&quot;level&quot;:&quot;%level&quot;,&quot;message&quot;:&quot;%message&quot;,&quot;file&quot;:&quot;%file&quot;,&quot;line&quot;:&quot;%line&quot;,&quot;exception&quot;:&quot;%exception&quot;}%newline" />
			</layout>
			<filter type="log4net.Filter.LevelRangeFilter">
				<levelMin value="Fatal" />
				<levelMax value="Fatal" />
			</filter>
		</appender>

		<!-- Custom SQLite Appender -->
		<!--appender name="SqliteAppender" type="Log4NetTest.log4net.SQLiteAppender, Log4NetTest" /-->
		<!--TABLE IF NOT EXISTS Log (
		Id INTEGER PRIMARY KEY AUTOINCREMENT,
		LogDate VARCHAR(255),
		Level VARCHAR(128),
		Logger VARCHAR(255),
		Message TEXT,
		Exception TEXT
		);-->

		<!-- Root Logger Configuration -->
		<root>
			<level value="DEBUG" />
			<appender-ref ref="ColoredConsoleAppender" />
			<appender-ref ref="RollingFileAppenderDebug" />
			<appender-ref ref="RollingFileAppenderInfo" />
			<appender-ref ref="RollingFileAppenderWarn" />
			<appender-ref ref="RollingFileAppenderError" />
			<appender-ref ref="RollingFileAppenderFatal" />
			<!--appender-ref ref="SqliteAppender" /-->
		</root>
	</log4net>
</configuration>
